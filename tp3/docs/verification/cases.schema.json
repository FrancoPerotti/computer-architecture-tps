{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifiesto de casos de verificación de TP3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "status",
    "scope",
    "latch_fixture",
    "groups"
  ],
  "properties": {
    "$schema": {
      "const": "./cases.schema.json"
    },
    "schema": {
      "const": "tp3-verification-cases"
    },
    "status": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "latch_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ifid",
        "idex",
        "exmem",
        "memwb"
      ],
      "properties": {
        "ifid": {
          "$ref": "#/$defs/fixture"
        },
        "idex": {
          "$ref": "#/$defs/fixture"
        },
        "exmem": {
          "$ref": "#/$defs/fixture"
        },
        "memwb": {
          "$ref": "#/$defs/fixture"
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "groupId": {
      "type": "string",
      "pattern": "^TEST-[A-Z]+-[0-9]{3}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^TEST-[A-Z]+-[0-9]{3}/C[0-9]{3}$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)\\S(?:[^\\r\\n]*\\S)?$"
    },
    "fixture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "value"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "case_count",
        "reuse_groups",
        "executions",
        "cases"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/groupId"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "reuse_groups": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/groupId"
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "replay_cases": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseId"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "top",
        "level",
        "timeout_seconds"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourcePath"
          }
        },
        "top": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
        },
        "level": {
          "enum": [
            "Unidad",
            "Integración local",
            "CPU",
            "Sistema",
            "Elaboración/revisión",
            "Implementación",
            "Placa"
          ]
        },
        "timeout_seconds": {
          "description": "Tiempo real máximo en segundos por caso de simulación; no incluye la compilación.",
          "type": "integer",
          "minimum": 1
        },
        "case_ids": {
          "description": "Casos del grupo (incluidas sus reejecuciones) a los que se aplica el banco; si se omite, se aplica a todos.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseId"
          }
        },
        "parameters": {
          "description": "Parámetros de elaboración del top: identificadores, constantes de paquete o literales enteros de SystemVerilog.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[A-Za-z_][A-Za-z0-9_$]*(?:::[A-Za-z_][A-Za-z0-9_$]*)*|-?[0-9]+|'[01xXzZ]|-?[1-9][0-9]*'[sS]?[bBoOdDhH][0-9a-fA-F_xXzZ?]+)$"
          }
        },
        "expected_rejection": {
          "description": "Rechazo controlado: exige REJECT con el ID solicitado, el diagnóstico tomado de expected y el código de salida indicado.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_code",
            "diagnostic_key"
          ],
          "properties": {
            "exit_code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "diagnostic_key": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputs",
        "expected",
        "kind",
        "origins"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/caseId"
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "expected": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "kind": {
          "enum": [
            "arithmetic_only",
            "artificial",
            "elaboration",
            "frame",
            "implementation_review",
            "integration_artificial",
            "integration_fixture",
            "program",
            "protocol_fixture",
            "review",
            "scenario",
            "serializer_fixture",
            "timer_scenario",
            "transaction",
            "vector"
          ]
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "bit"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            }
          }
        }
      }
    }
  }
}
